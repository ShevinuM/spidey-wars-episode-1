{
  "name": "spidey-wars-episode-1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "architecture": "depcruise src --config .dependency-cruiser.mjs --output-type err-long",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "duplication": "jscpd",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm lint && pnpm architecture && pnpm format && pnpm duplication && pnpm knip",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:smoke": "playwright test --project=smoke",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "test:visual:docker": "node scripts/visual-docker.ts",
    "coverage:merge": "mcr merge -r lcov,v8 --inputDir coverage/unit,coverage/e2e/raw --outputDir coverage/merged",
    "playwright:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.5.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.1",
    "@vitest/coverage-v8": "5.0.1",
    "dependency-cruiser": "18.3.1",
    "jscpd": "5.2.1",
    "knip": "6.36.0",
    "monocart-coverage-reports": "2.13.0",
    "oxlint": "1.83.0",
    "phaser": "4.2.1",
    "prettier": "3.9.7",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
}
